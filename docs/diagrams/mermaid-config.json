{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Inter, Arial, sans-serif",
    "fontSize": "15px",
    "background": "#FFFFFF",
    "primaryColor": "#ECF3F3",
    "primaryTextColor": "#12333B",
    "primaryBorderColor": "#1F7A80",
    "secondaryColor": "#FFF6E8",
    "tertiaryColor": "#F6FAFA",
    "lineColor": "#3B4A4D",
    "textColor": "#12333B",
    "clusterBkg": "#F6FAFA",
    "clusterBorder": "#B8CACC",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#ECF3F3",
    "actorBorder": "#1F7A80",
    "actorTextColor": "#12333B",
    "actorLineColor": "#B8CACC",
    "signalColor": "#3B4A4D",
    "signalTextColor": "#12333B",
    "labelBoxBkgColor": "#12333B",
    "labelBoxBorderColor": "#12333B",
    "labelTextColor": "#FFFFFF",
    "loopTextColor": "#12333B",
    "noteBkgColor": "#FFF6E8",
    "noteBorderColor": "#E8A33D",
    "noteTextColor": "#12333B",
    "activationBkgColor": "#DDEBEB",
    "activationBorderColor": "#1F7A80",
    "sequenceNumberColor": "#FFFFFF"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 36,
    "rankSpacing": 48,
    "padding": 14,
    "wrappingWidth": 280,
    "diagramPadding": 16
  },
  "sequence": {
    "mirrorActors": false,
    "wrap": true,
    "width": 190,
    "boxMargin": 10,
    "noteMargin": 10,
    "messageMargin": 34,
    "actorFontSize": 15,
    "messageFontSize": 14,
    "noteFontSize": 14,
    "diagramMarginX": 24,
    "diagramMarginY": 16
  }
}
