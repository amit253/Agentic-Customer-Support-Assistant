# Copy this file to .env or export these variables in your shell.
# Never commit a real provider key. The repository ignores .env files.

APP_NAME=agentic-customer-support
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Leave empty for keyless tests. Set locally only for live provider tests.
GROQ_API_KEY=
# Optional extra keys: a comma-separated GROQ_API_KEYS list and/or any
# GROQ_<NAME>_KEY variable. A rate-limited key is skipped for the next one.
GROQ_API_KEYS=
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# Router reasoning effort (low was measured as equally accurate and faster).
GROQ_ROUTER_REASONING_EFFORT=low
ROUTER_MAX_ATTEMPTS=2
ROUTER_RETRY_DELAY_SECONDS=0.25
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional Groq TTS adapter settings; the live baseline uses Windows TTS.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin
